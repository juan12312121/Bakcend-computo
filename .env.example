# ===== Backend TrinoFlow - TODO LOCAL =====
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
# Orígenes extra separados por coma (la app nativa ya está permitida). Ej.: http://192.168.1.172:4200
CORS_ORIGINS=http://192.168.1.172:4200

# MySQL local (servicio MySQL97)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=redstudent_db
# En la nube (Aiven): DB_SSL=true y el certificado CA en DB_SSL_CA (texto PEM, saltos como \n)
DB_SSL=false
DB_SSL_CA=

# JWT
JWT_SECRET=
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary (fotos y documentos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Correo
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="RedStudent <noreply@redstudent.com>"

# Notificaciones push: JSON de la cuenta de servicio de Firebase (ruta relativa a backend/).
# Sin esto, las push se escriben en la consola.
# FIREBASE_SERVICE_ACCOUNT=firebase-cuenta-servicio.json

# Límites
MAX_FILE_SIZE=5242880
MAX_VIDEO_SIZE=52428800
MAX_FILES_PER_REQUEST=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Firma de los códigos QR de los boletos (texto largo y secreto)
BOLETOS_SECRETO=
# Pagos (opcionales; sin ellos, fuera de producción se usa el modo de prueba)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
# Llamadas: servidor TURN opcional (redes estrictas)
TURN_URL=
TURN_USUARIO=
TURN_CLAVE=
